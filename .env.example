# Application Environment Configuration
# Copy this file to .env before starting containers

# Execution Device: 'auto' | 'cuda' | 'cpu' | 'mps'
DEVICE=auto

# Server Ports
API_PORT=8000
DASHBOARD_PORT=8501

# Host Bindings
HOST=0.0.0.0

# PyTorch & Python settings
PYTHONUNBUFFERED=1
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4

# Data & Output Roots (mounted inside /app/...)
EXPERIMENTS_DIR=./experiments
ACTIVATIONS_DIR=./activations
DATA_DIR=./data
REPORTS_DIR=./reports
